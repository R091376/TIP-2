# Upstox Bearer access token (NOT the app key / client id)
UPSTOX_ACCESS_TOKEN=

# Admin / test bootstrap (match local tip DB defaults)
TIP_ADMIN_PASSWORD=admin
TIP_TEST_USERNAME=test
TIP_TEST_PASSWORD=test
TIP_TEST_DISPLAY_NAME=Tester

# Watchlist store: postgres | memory  (Java: TIP_WATCHLIST_STORE)
TIP_WATCHLIST_STORE=postgres

# Postgres (SQLAlchemy URL; +psycopg driver preferred)
# Local (start-tip2.bat forces this unless LOCAL_DATABASE_URL is set):
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/tip
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tip
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
# Render / Neon (set only on the cloud service, not for local start):
# DATABASE_URL=postgresql+psycopg://user:pass@host/neondb?sslmode=require

# JWT access tokens (Bearer). Prefer JWT_SECRET in production.
JWT_SECRET=tip-dev-jwt-secret-change-me
JWT_EXPIRE_HOURS=8
# Fallback signing secret if JWT_SECRET is empty (legacy name)
SESSION_SECRET=tip-dev-session-secret-change-me

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Render example:
# CORS_ALLOWED_ORIGINS=https://tip2-web.onrender.com,http://localhost:5173

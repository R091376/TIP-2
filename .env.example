# Upstox analytics/access token (1-year validity, used as Bearer token)
UPSTOX_ACCESS_TOKEN=

# Admin bootstrap (parity with Java tip.users.admin-password)
TIP_ADMIN_PASSWORD=admin

# Watchlist store: postgres | memory  (Java: TIP_WATCHLIST_STORE)
TIP_WATCHLIST_STORE=postgres

# Postgres (Java Spring datasource defaults)
# DATABASE_URL=postgresql://postgres:admin@localhost:5432/tip2
